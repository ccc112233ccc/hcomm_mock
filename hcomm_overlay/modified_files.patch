+
+void FillNodeExtraMetadata(gui::Node* node, TaskStub* task)
+{
+    gui::LinkType guiLinkType;
+    if (ToGuiLinkType(task->GetLinkType(), guiLinkType)) {
+        node->set_linktype(guiLinkType);
+    }
+
+    switch (task->GetType()) {
+        case TaskTypeStub::READ:
+            FillTransferMetadata(node, static_cast<const TaskStubRead*>(task));
+            break;
+        case TaskTypeStub::READ_REDUCE:
+            FillTransferMetadata(node, static_cast<const TaskStubReadReduce*>(task));
+            break;
+        case TaskTypeStub::WRITE:
+            FillTransferMetadata(node, static_cast<const TaskStubWrite*>(task));
+            break;
+        case TaskTypeStub::WRITE_REDUCE:
+            FillTransferMetadata(node, static_cast<const TaskStubWriteReduce*>(task));
+            break;
+        case TaskTypeStub::BEING_READ:
+            FillTransferMetadata(node, static_cast<const TaskStubBeingRead*>(task));
+            break;
+        case TaskTypeStub::BEING_READ_REDUCE:
+            FillTransferMetadata(node, static_cast<const TaskStubBeingReadReduce*>(task));
+            break;
+        case TaskTypeStub::BEING_WRITTEN:
+            FillTransferMetadata(node, static_cast<const TaskStubBeingWritten*>(task));
+            break;
+        case TaskTypeStub::BEING_WRITTEN_REDUCE:
+            FillTransferMetadata(node, static_cast<const TaskStubBeingWrittenReduce*>(task));
+            break;
+        case TaskTypeStub::POST:
+            node->set_remoterank(static_cast<const TaskStubPost*>(task)->GetRemoteRank());
+            break;
+        case TaskTypeStub::WAIT:
+            node->set_remoterank(static_cast<const TaskStubWait*>(task)->GetRemoteRank());
+            break;
+        case TaskTypeStub::LOOP_START: {
+            auto loopTask = static_cast<const TaskStubLoopStart*>(task);
+            node->set_loopidx(loopTask->loopIdx);
+            node->set_loopgroupidx(loopTask->loopGroupIdx);
+            break;
+        }
+        case TaskTypeStub::LOOP_END: {
+            auto loopTask = static_cast<const TaskStubLoopEnd*>(task);
+            node->set_loopidx(loopTask->loopIdx);
+            node->set_loopgroupidx(loopTask->loopGroupIdx);
+            break;
+        }
+        default:
+            break;
+    }
+}
